DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_NAME=Voip_portal
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development

# Separate Auto VoIP module. Manual reports are never written by this integration.
# Set the user ID of the account that will view automatic reports. Keep the backend running.
CONNECTIVO_SYNC_ENABLED=false
CONNECTIVO_USERNAME=
CONNECTIVO_PASSWORD=
CONNECTIVO_REPORT_OWNER_ID=
CONNECTIVO_BILLING_NAME=BT-rev1
CONNECTIVO_REPORT_DIALER=MED_MAIN_BTrev1
