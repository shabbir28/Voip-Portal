{
  "name": "voip-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch --watch-path=backend --watch-path=shared backend/index.js\" \"vite frontend --host 127.0.0.1\"",
    "build": "vite build frontend",
    "start": "node backend/index.js",
    "connectivo:check": "node backend/integrations/connectivo/check.js",
    "connectivo:sample": "node backend/integrations/connectivo/sample.js",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write frontend/src backend shared tests",
    "format:check": "prettier --check frontend/src backend shared tests"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.1.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.468.0",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "vite": "^7.1.10"
  }
}
